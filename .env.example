## ============================================
## PROFESSIONAL PLATFORM - Environment Configuration
## ============================================
## Copy this file to .env and fill in the values.
## For production, also see .env.production

## --- App ---
APP_NAME="House Roof"
PLATFORM_NAME="House Roof"
PLATFORM_PUBLIC_NAME="House Roof"
COMMERCE_SHIPPING_COST=15.00
COMMERCE_TAX_RATE=0.21
SUPER_ADMIN_EMAIL=julianortizt@gmail.com
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Europe/Madrid
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

## --- Logging ---
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

## --- Database ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=houseroof_db
DB_USERNAME=root
DB_PASSWORD=

## --- Sessions ---
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTPONLY=true

## --- Cache & Queue ---
CACHE_STORE=file
QUEUE_CONNECTION=sync

## --- Filesystem ---
FILESYSTEM_DISK=public

## --- Mail (SMTP) ---
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=hello@TU_DOMINIO.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@TU_DOMINIO.com"
MAIL_FROM_NAME="House Roof"

## --- Stripe (disabled for now - no prices) ---
# STRIPE_KEY=pk_test_xxxx
# STRIPE_SECRET=sk_test_xxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxx

## --- Filament Admin ---
FILAMENT_PATH=admin

## --- AI Providers (configured in admin settings) ---
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

## ============================================
## PRODUCTION SETTINGS (Hostinger)
## ============================================
## When deploying to production, change:
##   APP_ENV=production
##   APP_DEBUG=false
##   APP_URL=https://TU_DOMINIO.com
##   SESSION_SECURE_COOKIE=true
##   SESSION_DRIVER=file
##   CACHE_STORE=file
##   QUEUE_CONNECTION=sync
##   LOG_LEVEL=error
##
## Then run:
##   php artisan config:cache
##   php artisan route:cache
##   php artisan view:cache
##   php artisan storage:link
## ============================================

# MapTiler Satellite (https://cloud.maptiler.com — plan gratuito)
MAPTILER_KEY=

# === Anti-clone / anti-downloader ===
# If false, the unauthorized-domain guard does nothing.
ANTI_CLONE_GUARD=true
# Comma-separated hosts allowed to serve the site (subdomains allowed automatically).
# Add your real domain here, e.g. midominio.com,www.midominio.com
ANTI_CLONE_ALLOWED_HOSTS=localhost,127.0.0.1,houseroof.eu,houseroof.com

## ============================================
## VERCEL + TURSO (produccion)
## ============================================
## Crea la base de datos en Vercel Marketplace (Turso). Vercel inyecta
## TURSO_DATABASE_URL y TURSO_AUTH_TOKEN automaticamente.
## En Vercel configura ademas:
##   APP_KEY=<genera una con: php artisan key:generate --show>
##   APP_URL=https://TU_PROYECTO.vercel.app
##   DB_CONNECTION=libsql
##   SESSION_DRIVER=database
##   CACHE_STORE=database
##   PUBLIC_DISK_DRIVER=s3
##   FILESYSTEM_DISK=public
##   MEDIA_DISK=public
##   AWS_BUCKET / AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY
##   AWS_URL / AWS_ENDPOINT / AWS_DEFAULT_REGION
##   LOG_CHANNEL=stderr
## No ejecutes `php artisan config:cache` en el build de Vercel.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

